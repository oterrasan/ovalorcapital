{
  "version": 2,
  "outputDirectory": "public",
  "crons": [],
  "functions": {
    "api/manage.js": { "maxDuration": 120 }
  },
  "routes": [
    { "src": "^/js/(.+)$", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },

    { "src": "^/sitemap\\.xml$", "dest": "/api/sitemap" },
    { "src": "^/brasil-on/?$", "dest": "/api/category?cat=brasil-on" },
    { "src": "^/politica/?$", "dest": "/api/category?cat=politica" },
    { "src": "^/policia/?$", "dest": "/api/category?cat=policia" },
    { "src": "^/futebol/?$", "dest": "/api/category?cat=futebol" },
    { "src": "^/giro/?$", "dest": "/api/category?cat=giro" },

    { "src": "^/(brasil-on|politica|policia|futebol|giro)/([^/]+)/?$", "dest": "/api/article?cat=$1&slug=$2" }
  ]
}
