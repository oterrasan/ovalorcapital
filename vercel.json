{
  "version": 2,
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/manage?action=refresh_token",
      "schedule": "0 3 1 * *"
    }
  ],
  "build": {
    "env": {
      "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
    }
  },
  "routes": [
    { "src": "^/$",          "dest": "/api/home", "headers": { "Cache-Control": "public, s-maxage=120, stale-while-revalidate=600" } },
    { "src": "^/index\\.html$", "dest": "/api/home" },

    { "src": "^/js/(.+)$",    "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },
    { "src": "^/admin(.*)",   "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },
    { "src": "^/inteligencia$","headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },

    { "handle": "filesystem" },

    { "src": "^/sitemap\\.xml$",             "dest": "/api/sitemap" },

    { "src": "^/quem-somos/?$",             "dest": "/api/institutional?page=quem-somos" },
    { "src": "^/politica-editorial/?$",     "dest": "/api/institutional?page=politica-editorial" },

    { "src": "^/trabalho/?$",               "dest": "/api/landing?section=trabalho" },
    { "src": "^/financas/?$",               "dest": "/api/landing?section=financas" },
    { "src": "^/moradia/?$",                "dest": "/api/landing?section=moradia" },
    { "src": "^/seguranca/?$",              "dest": "/api/landing?section=seguranca" },
    { "src": "^/bem-estar/?$",              "dest": "/api/landing?section=bem-estar" },

    { "src": "^/radar/?$",                  "dest": "/api/live?page=radar" },
    { "src": "^/tv-ovc/?$",                 "dest": "/api/live?page=tv-ovc" },
    { "src": "^/radio-ovc/?$",              "dest": "/api/live?page=radio-ovc" },
    { "src": "^/dados/cotacoes/?$",         "dest": "/api/live?page=cotacoes" },
    { "src": "^/dados/agenda-economica/?$", "dest": "/api/live?page=agenda" },
    { "src": "^/dados/?$",                  "dest": "/api/live?page=dados" },

    { "src": "^/politica/?$",               "dest": "/api/category?cat=politica" },
    { "src": "^/economia/?$",               "dest": "/api/category?cat=economia" },
    { "src": "^/negocios/?$",               "dest": "/api/category?cat=negocios" },
    { "src": "^/investimentos/?$",          "dest": "/api/category?cat=investimentos" },
    { "src": "^/seguros/?$",                "dest": "/api/category?cat=seguros" },
    { "src": "^/mercados/?$",               "dest": "/api/category?cat=mercados" },
    { "src": "^/educacao/?$",               "dest": "/api/category?cat=educacao" },
    { "src": "^/industria/?$",              "dest": "/api/category?cat=industria" },
    { "src": "^/tecnologia/?$",             "dest": "/api/category?cat=tecnologia" },
    { "src": "^/esportes/?$",               "dest": "/api/category?cat=esportes" },
    { "src": "^/saude/?$",                  "dest": "/api/category?cat=saude" },
    { "src": "^/familia/?$",                "dest": "/api/category?cat=familia" },
    { "src": "^/tributos/?$",               "dest": "/api/category?cat=tributos" },
    { "src": "^/regulacao/?$",              "dest": "/api/category?cat=regulacao" },
    { "src": "^/parcerias/?$",              "dest": "/api/category?cat=parcerias" },
    { "src": "^/internacional/?$",          "dest": "/api/category?cat=internacional" },
    { "src": "^/variedades/?$",             "dest": "/api/category?cat=variedades" },
    { "src": "^/investigativo/?$",          "dest": "/api/category?cat=investigativo" },
    { "src": "^/investigativo/denuncias/?$",       "dest": "/api/category?cat=investigativo&section=denuncias" },
    { "src": "^/investigativo/contas-publicas/?$", "dest": "/api/category?cat=investigativo&section=contas-publicas" },
    { "src": "^/cultura/?$",                "dest": "/api/category?cat=cultura" },
    { "src": "^/profissoes/?$",             "dest": "/api/category?cat=profissoes" },
    { "src": "^/profissoes/medicina/?$",    "dest": "/api/category?cat=profissoes&section=medicina" },
    { "src": "^/profissoes/enfermagem/?$",  "dest": "/api/category?cat=profissoes&section=enfermagem" },
    { "src": "^/profissoes/odontologia/?$", "dest": "/api/category?cat=profissoes&section=odontologia" },
    { "src": "^/profissoes/farmacia/?$",    "dest": "/api/category?cat=profissoes&section=farmacia" },
    { "src": "^/profissoes/psicologia/?$",  "dest": "/api/category?cat=profissoes&section=psicologia" },
    { "src": "^/profissoes/fisioterapia/?$","dest": "/api/category?cat=profissoes&section=fisioterapia" },
    { "src": "^/profissoes/nutricao/?$",    "dest": "/api/category?cat=profissoes&section=nutricao" },
    { "src": "^/profissoes/veterinaria/?$", "dest": "/api/category?cat=profissoes&section=veterinaria" },
    { "src": "^/profissoes/biomedicina/?$", "dest": "/api/category?cat=profissoes&section=biomedicina" },
    { "src": "^/profissoes/fonoaudiologia/?$","dest": "/api/category?cat=profissoes&section=fonoaudiologia" },
    { "src": "^/profissoes/direito/?$",     "dest": "/api/category?cat=profissoes&section=direito" },
    { "src": "^/profissoes/contabilidade/?$","dest": "/api/category?cat=profissoes&section=contabilidade" },
    { "src": "^/profissoes/administracao/?$","dest": "/api/category?cat=profissoes&section=administracao" },
    { "src": "^/profissoes/economia/?$",    "dest": "/api/category?cat=profissoes&section=economia" },
    { "src": "^/profissoes/auditoria/?$",   "dest": "/api/category?cat=profissoes&section=auditoria" },
    { "src": "^/profissoes/engenharia-civil/?$",    "dest": "/api/category?cat=profissoes&section=engenharia-civil" },
    { "src": "^/profissoes/arquitetura/?$", "dest": "/api/category?cat=profissoes&section=arquitetura" },
    { "src": "^/profissoes/engenharia-eletrica/?$", "dest": "/api/category?cat=profissoes&section=engenharia-eletrica" },
    { "src": "^/profissoes/engenharia-quimica/?$",  "dest": "/api/category?cat=profissoes&section=engenharia-quimica" },
    { "src": "^/profissoes/ti/?$",          "dest": "/api/category?cat=profissoes&section=ti" },
    { "src": "^/profissoes/agronomia/?$",   "dest": "/api/category?cat=profissoes&section=agronomia" },
    { "src": "^/profissoes/jornalismo/?$",  "dest": "/api/category?cat=profissoes&section=jornalismo" },
    { "src": "^/profissoes/publicidade/?$", "dest": "/api/category?cat=profissoes&section=publicidade" },
    { "src": "^/profissoes/relacoes-publicas/?$",   "dest": "/api/category?cat=profissoes&section=relacoes-publicas" },
    { "src": "^/profissoes/pedagogia/?$",   "dest": "/api/category?cat=profissoes&section=pedagogia" },
    { "src": "^/profissoes/rh/?$",          "dest": "/api/category?cat=profissoes&section=rh" },
    { "src": "^/profissoes/servico-social/?$",      "dest": "/api/category?cat=profissoes&section=servico-social" },
    { "src": "^/vagas/?$",                  "dest": "/api/category?cat=vagas" },
    { "src": "^/empregos/?$",               "dest": "/api/category?cat=vagas" },
    { "src": "^/concursos/?$",              "dest": "/api/category?cat=concursos" },
    { "src": "^/imoveis/?$",                "dest": "/api/category?cat=imoveis" },
    { "src": "^/esg/?$",                    "dest": "/api/category?cat=esg" },
    { "src": "^/defesa/?$",                 "dest": "/api/category?cat=defesa" },
    { "src": "^/religiao/?$",               "dest": "/api/category?cat=religiao" },
    { "src": "^/colunistas/?$",             "dest": "/api/category?cat=colunistas" },

    { "src": "^/api/editor_ia$",            "dest": "/api/manage?action=editor_ia" },
    { "src": "^/api/seo_batch$",            "dest": "/api/manage?action=seo_batch" },
    { "src": "^/api/live-data$",            "dest": "/api/portal-posts?format=live-data" },
    { "src": "^/api/ig-setup$",             "dest": "/api/ig-handler?op=setup" },
    { "src": "^/api/ig-queue$",             "dest": "/api/ig-handler?op=queue" },
    { "src": "^/api/ig-proxy$",             "dest": "/api/ig-handler?op=proxy" },
    { "src": "^/api/inteligencia$",         "dest": "/api/manage?action=inteligencia" },
    { "src": "^/api/auth/validate-token$",  "dest": "/api/manage?action=validate-token" },
    { "src": "^/admin/instagram/?$",        "dest": "/admin/instagram.html" },

    { "src": "^/materia/?$",               "dest": "/api/article" },
    { "src": "^/og/?$",                    "dest": "/api/portal-posts?format=og" },

    { "src": "^/([^/]+)/([^/]+)/?$",       "dest": "/api/article?cat=$1&slug=$2" }
  ]
}
