{
  "version": 2,
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/refresh_token",
      "schedule": "0 3 1 * *"
    }
  ],
  "functions": {
    "api/run.js": {
      "maxDuration": 60
    },
    "api/run_portal.js": {
      "maxDuration": 60
    },
    "api/approve.js": {
      "maxDuration": 60
    },
    "api/approve_portal.js": {
      "maxDuration": 30
    },
    "api/portal-posts.js": {
      "maxDuration": 15
    },
    "api/status.js": {
      "maxDuration": 10
    },
    "api/refresh_token.js": {
      "maxDuration": 30
    },
    "api/recategorize.js": {
      "maxDuration": 60
    },
    "api/fix_cats.js": {
      "maxDuration": 30
    },
    "api/fix_titles.js": {
      "maxDuration": 300
    },
    "api/manual_post.js": {
      "maxDuration": 60
    }
  },
  "build": {
    "env": {
      "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}