{
  "version": 2,
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/refresh_token",
      "schedule": "0 3 1 * *"
    }
  ],
  "functions": {
    "api/run.js":           { "maxDuration": 60 },
    "api/run_portal.js":   { "maxDuration": 60 },
    "api/manage.js":       { "maxDuration": 60 },
    "api/editor_ia.js":    { "maxDuration": 60 },
    "api/manual_post.js":  { "maxDuration": 60 },
    "api/auditoria.js":    { "maxDuration": 60 },
    "api/portal-posts.js": { "maxDuration": 15 },
    "api/ig_publish.js":   { "maxDuration": 60 },
    "api/fix_images.js":   { "maxDuration": 55 },
    "api/live-data.js":    { "maxDuration": 15 },
    "api/refresh_token.js":{ "maxDuration": 30 },
    "api/sitemap.js":      { "maxDuration": 15 },
    "api/article-ssr.js":  { "maxDuration": 10 },
    "api/article.js":      { "maxDuration": 10 },
    "api/landing.js":      { "maxDuration": 15 },
    "api/category.js":     { "maxDuration": 10 },
    "api/live.js":         { "maxDuration": 10 }
  },
  "build": {
    "env": {
      "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=300" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml",             "destination": "/api/sitemap" },

    { "source": "/trabalho",               "destination": "/api/landing?section=trabalho" },
    { "source": "/trabalho/",              "destination": "/api/landing?section=trabalho" },
    { "source": "/financas",               "destination": "/api/landing?section=financas" },
    { "source": "/financas/",              "destination": "/api/landing?section=financas" },
    { "source": "/moradia",                "destination": "/api/landing?section=moradia" },
    { "source": "/moradia/",               "destination": "/api/landing?section=moradia" },
    { "source": "/vc",                     "destination": "/api/landing?section=vc" },
    { "source": "/vc/",                    "destination": "/api/landing?section=vc" },
    { "source": "/seguranca",              "destination": "/api/landing?section=seguranca" },
    { "source": "/seguranca/",             "destination": "/api/landing?section=seguranca" },
    { "source": "/bem-estar",              "destination": "/api/landing?section=bem-estar" },
    { "source": "/bem-estar/",             "destination": "/api/landing?section=bem-estar" },

    { "source": "/radar",                  "destination": "/api/live?page=radar" },
    { "source": "/radar/",                 "destination": "/api/live?page=radar" },
    { "source": "/tv-ovc",                 "destination": "/api/live?page=tv-ovc" },
    { "source": "/tv-ovc/",                "destination": "/api/live?page=tv-ovc" },
    { "source": "/radio-ovc",              "destination": "/api/live?page=radio-ovc" },
    { "source": "/radio-ovc/",             "destination": "/api/live?page=radio-ovc" },
    { "source": "/dados/cotacoes",         "destination": "/api/live?page=cotacoes" },
    { "source": "/dados/cotacoes/",        "destination": "/api/live?page=cotacoes" },
    { "source": "/dados/agenda-economica", "destination": "/api/live?page=agenda" },
    { "source": "/dados/agenda-economica/","destination": "/api/live?page=agenda" },
    { "source": "/dados",                  "destination": "/api/live?page=dados" },
    { "source": "/dados/",                 "destination": "/api/live?page=dados" },

    { "source": "/politica",               "destination": "/api/category?cat=politica" },
    { "source": "/politica/",              "destination": "/api/category?cat=politica" },
    { "source": "/economia",               "destination": "/api/category?cat=economia" },
    { "source": "/economia/",              "destination": "/api/category?cat=economia" },
    { "source": "/negocios",               "destination": "/api/category?cat=negocios" },
    { "source": "/negocios/",              "destination": "/api/category?cat=negocios" },
    { "source": "/investimentos",          "destination": "/api/category?cat=investimentos" },
    { "source": "/investimentos/",         "destination": "/api/category?cat=investimentos" },
    { "source": "/seguros",                "destination": "/api/category?cat=seguros" },
    { "source": "/seguros/",               "destination": "/api/category?cat=seguros" },
    { "source": "/mercados",               "destination": "/api/category?cat=mercados" },
    { "source": "/mercados/",              "destination": "/api/category?cat=mercados" },
    { "source": "/educacao",               "destination": "/api/category?cat=educacao" },
    { "source": "/educacao/",              "destination": "/api/category?cat=educacao" },
    { "source": "/industria",              "destination": "/api/category?cat=industria" },
    { "source": "/industria/",             "destination": "/api/category?cat=industria" },
    { "source": "/tecnologia",             "destination": "/api/category?cat=tecnologia" },
    { "source": "/tecnologia/",            "destination": "/api/category?cat=tecnologia" },
    { "source": "/esportes",               "destination": "/api/category?cat=esportes" },
    { "source": "/esportes/",              "destination": "/api/category?cat=esportes" },
    { "source": "/saude",                  "destination": "/api/category?cat=saude" },
    { "source": "/saude/",                 "destination": "/api/category?cat=saude" },
    { "source": "/familia",                "destination": "/api/category?cat=familia" },
    { "source": "/familia/",               "destination": "/api/category?cat=familia" },
    { "source": "/tributos",               "destination": "/api/category?cat=tributos" },
    { "source": "/tributos/",              "destination": "/api/category?cat=tributos" },
    { "source": "/regulacao",              "destination": "/api/category?cat=regulacao" },
    { "source": "/regulacao/",             "destination": "/api/category?cat=regulacao" },
    { "source": "/parcerias",              "destination": "/api/category?cat=parcerias" },
    { "source": "/parcerias/",             "destination": "/api/category?cat=parcerias" },
    { "source": "/internacional",          "destination": "/api/category?cat=internacional" },
    { "source": "/internacional/",         "destination": "/api/category?cat=internacional" },
    { "source": "/variedades",             "destination": "/api/category?cat=variedades" },
    { "source": "/variedades/",            "destination": "/api/category?cat=variedades" },
    { "source": "/investigativo",          "destination": "/api/category?cat=investigativo" },
    { "source": "/investigativo/",         "destination": "/api/category?cat=investigativo" },
    { "source": "/cultura",                "destination": "/api/category?cat=cultura" },
    { "source": "/cultura/",               "destination": "/api/category?cat=cultura" },
    { "source": "/profissoes",             "destination": "/api/category?cat=profissoes" },
    { "source": "/profissoes/",            "destination": "/api/category?cat=profissoes" },
    { "source": "/vagas",                  "destination": "/api/category?cat=vagas" },
    { "source": "/vagas/",                 "destination": "/api/category?cat=vagas" },
    { "source": "/concursos",              "destination": "/api/category?cat=concursos" },
    { "source": "/concursos/",             "destination": "/api/category?cat=concursos" },
    { "source": "/imoveis",                "destination": "/api/category?cat=imoveis" },
    { "source": "/imoveis/",               "destination": "/api/category?cat=imoveis" },
    { "source": "/esg",                    "destination": "/api/category?cat=esg" },
    { "source": "/esg/",                   "destination": "/api/category?cat=esg" },
    { "source": "/defesa",                 "destination": "/api/category?cat=defesa" },
    { "source": "/defesa/",                "destination": "/api/category?cat=defesa" },
    { "source": "/religiao",               "destination": "/api/category?cat=religiao" },
    { "source": "/religiao/",              "destination": "/api/category?cat=religiao" },
    { "source": "/colunistas",             "destination": "/api/category?cat=colunistas" },
    { "source": "/colunistas/",            "destination": "/api/category?cat=colunistas" },

    { "source": "/:cat/:slug/",            "destination": "/api/article?cat=:cat&slug=:slug" },
    { "source": "/:cat/:slug",             "destination": "/api/article?cat=:cat&slug=:slug" },

    { "source": "/materia",                "destination": "/api/article-ssr" },
    { "source": "/materia/",               "destination": "/api/article-ssr" },
    { "source": "/inteligencia",           "destination": "/inteligencia.html" },
    { "source": "/inteligencia/",          "destination": "/inteligencia.html" },
    { "source": "/og",                     "destination": "/api/portal-posts?format=og" },
    { "source": "/og/",                    "destination": "/api/portal-posts?format=og" }
  ]
}
