{
  "version": 2,
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/manage?action=refresh_token",
      "schedule": "0 3 1 * *"
    }
  ],
  "build": {
    "env": {
      "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
    }
  },
  "routes": [
    { "src": "^/$",            "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },
    { "src": "^/js/(.+)$",    "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },
    { "src": "^/admin(.*)",   "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },
    { "src": "^/inteligencia$","headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache" }, "continue": true },

    { "src": "^/investimentos/?$",  "headers": { "Location": "/financas/" },   "status": 301 },
    { "src": "^/seguros/?$",        "headers": { "Location": "/financas/" },   "status": 301 },
    { "src": "^/mercados/?$",       "headers": { "Location": "/financas/" },   "status": 301 },
    { "src": "^/saude/?$",          "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/carreira/?$",       "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/imoveis/?$",        "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/cultura/?$",        "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/religiao/?$",       "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/educacao/?$",       "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/variedades/?$",     "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/investigativo/?$",  "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/seguranca/?$",      "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/esg/?$",            "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/defesa/?$",         "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/profissoes/?$",     "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/vagas/?$",          "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/empregos/?$",       "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/concursos/?$",      "headers": { "Location": "/brasil-on/" },  "status": 301 },
    { "src": "^/parcerias/?$",      "headers": { "Location": "/negocios/" },   "status": 301 },
    { "src": "^/tributos/?$",       "headers": { "Location": "/economia/" },   "status": 301 },
    { "src": "^/tributacao/?$",     "headers": { "Location": "/economia/" },   "status": 301 },
    { "src": "^/regulacao/?$",      "headers": { "Location": "/economia/" },   "status": 301 },

    { "src": "^/investimentos/(.+)$", "headers": { "Location": "/financas/$1" },   "status": 301 },
    { "src": "^/seguros/(.+)$",       "headers": { "Location": "/financas/$1" },   "status": 301 },
    { "src": "^/mercados/(.+)$",      "headers": { "Location": "/financas/$1" },   "status": 301 },
    { "src": "^/saude/(.+)$",         "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/carreira/(.+)$",      "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/imoveis/(.+)$",       "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/cultura/(.+)$",       "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/religiao/(.+)$",      "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/educacao/(.+)$",      "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/variedades/(.+)$",    "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/investigativo/(.+)$", "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/seguranca/(.+)$",     "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/esg/(.+)$",           "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/defesa/(.+)$",        "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/profissoes/(.+)$",    "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/vagas/(.+)$",         "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/empregos/(.+)$",      "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/concursos/(.+)$",     "headers": { "Location": "/brasil-on/$1" },  "status": 301 },
    { "src": "^/parcerias/(.+)$",     "headers": { "Location": "/negocios/$1" },   "status": 301 },
    { "src": "^/tributos/(.+)$",      "headers": { "Location": "/economia/$1" },   "status": 301 },
    { "src": "^/tributacao/(.+)$",    "headers": { "Location": "/economia/$1" },   "status": 301 },
    { "src": "^/regulacao/(.+)$",     "headers": { "Location": "/economia/$1" },   "status": 301 },

    { "handle": "filesystem" },

    { "src": "^/sitemap\\.xml$",             "dest": "/api/sitemap" },

    { "src": "^/quem-somos/?$",             "dest": "/api/institutional?page=quem-somos" },
    { "src": "^/politica-editorial/?$",     "dest": "/api/institutional?page=politica-editorial" },

    { "src": "^/trabalho/?$",               "dest": "/api/landing?section=trabalho" },
    { "src": "^/moradia/?$",                "dest": "/api/landing?section=moradia" },
    { "src": "^/seguranca/?$",              "dest": "/api/landing?section=seguranca" },
    { "src": "^/bem-estar/?$",              "dest": "/api/landing?section=bem-estar" },

    { "src": "^/radar/?$",                  "dest": "/api/live?page=radar" },
    { "src": "^/tv-ovc/?$",                 "dest": "/api/live?page=tv-ovc" },
    { "src": "^/radio-ovc/?$",              "dest": "/api/live?page=radio-ovc" },
    { "src": "^/dados/cotacoes/?$",         "dest": "/api/live?page=cotacoes" },
    { "src": "^/dados/agenda-economica/?$", "dest": "/api/live?page=agenda" },
    { "src": "^/dados/?$",                  "dest": "/api/live?page=dados" },

    { "src": "^/politica/?$",               "dest": "/api/category?cat=politica" },
    { "src": "^/economia/?$",               "dest": "/api/category?cat=economia" },
    { "src": "^/negocios/?$",               "dest": "/api/category?cat=negocios" },
    { "src": "^/financas/?$",               "dest": "/api/category?cat=financas" },
    { "src": "^/industria/?$",              "dest": "/api/category?cat=industria" },
    { "src": "^/tecnologia/?$",             "dest": "/api/category?cat=tecnologia" },
    { "src": "^/esportes/?$",               "dest": "/api/category?cat=esportes" },
    { "src": "^/familia/?$",               "dest": "/api/category?cat=familia" },
    { "src": "^/internacional/?$",          "dest": "/api/category?cat=internacional" },
    { "src": "^/brasil-on/?$",              "dest": "/api/category?cat=brasil-on" },
    { "src": "^/colunistas/?$",             "dest": "/api/category?cat=colunistas" },
    { "src": "^/colunistas/([^/]+-[a-f0-9]{8})/?$", "dest": "/api/article?cat=colunistas&slug=$1" },
    { "src": "^/colunistas/([^/]+)/?$",      "dest": "/api/category?cat=colunistas&section=$1" },

    { "src": "^/api/editor_ia$",            "dest": "/api/manage?action=editor_ia" },
    { "src": "^/api/seo_batch$",            "dest": "/api/manage?action=seo_batch" },
    { "src": "^/api/live-data$",            "dest": "/api/portal-posts?format=live-data" },
    { "src": "^/api/ig-setup$",             "dest": "/api/ig-handler?op=setup" },
    { "src": "^/api/ig-queue$",             "dest": "/api/ig-handler?op=queue" },
    { "src": "^/api/ig-proxy$",             "dest": "/api/ig-handler?op=proxy" },
    { "src": "^/api/inteligencia$",         "dest": "/api/manage?action=inteligencia" },
    { "src": "^/api/auth/validate-token$",  "dest": "/api/manage?action=validate-token" },
    { "src": "^/admin/instagram/?$",        "dest": "/admin/instagram.html" },

    { "src": "^/materia/?$",               "dest": "/api/article" },
    { "src": "^/og/?$",                    "dest": "/api/portal-posts?format=og" },

    { "src": "^/([^/]+)/([^/]+)/?$",       "dest": "/api/article?cat=$1&slug=$2" }
  ]
}
