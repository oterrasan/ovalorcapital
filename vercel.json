{
  "version": 2,
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/manage?action=refresh_token",
      "schedule": "0 3 1 * *"
    }
  ],
  "build": {
    "env": {
      "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/inteligencia",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",                         "destination": "/api/home" },
    { "source": "/index.html",               "destination": "/api/home" },

    { "source": "/sitemap.xml",             "destination": "/api/sitemap" },

    { "source": "/quem-somos",              "destination": "/api/institutional?page=quem-somos" },
    { "source": "/quem-somos/",             "destination": "/api/institutional?page=quem-somos" },
    { "source": "/politica-editorial",      "destination": "/api/institutional?page=politica-editorial" },
    { "source": "/politica-editorial/",     "destination": "/api/institutional?page=politica-editorial" },

