{
  "version": 2,
  "crons": [
    {
      "path": "/api/refresh_token",
      "schedule": "0 3 1 * *"
    }
  ],
  "rewrites": [
    { "source": "/materia/:slug", "destination": "/api/materia/:slug" }
  ],
  "functions": {
    "api/run.js": { "maxDuration": 60 },
    "api/run_portal.js": { "maxDuration": 60 },
    "api/approve.js": { "maxDuration": 60 },
    "api/approve_portal.js": { "maxDuration": 30 },
    "api/portal-posts.js": { "maxDuration": 15 },
    "api/materia/[slug].js": { "maxDuration": 10 },
    "api/status.js": { "maxDuration": 10 },
    "api/refresh_token.js": { "maxDuration": 30 }
  },
  "build": {
    "env": { "SHARP_IGNORE_GLOBAL_LIBVIPS": "1" }
  }
}
